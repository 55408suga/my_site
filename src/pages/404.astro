---
import '@/styles/global.css';
import { getRelativeLocaleUrl } from 'astro:i18n';

const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const jaHome = getRelativeLocaleUrl('ja', '');
const enHome = getRelativeLocaleUrl('en', '');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>404 — Not Found</title>
    <meta name="description" content="Page not found." />
    <meta name="theme-color" content="#09090b" />
    <link rel="icon" type="image/svg+xml" href={`${baseUrl}favicon.svg`} />
  </head>
  <body class="grid min-h-screen place-items-center">
    <main class="mx-auto max-w-md px-6 text-center">
      <p class="text-xs tracking-[0.3em] text-amber-400 uppercase">404</p>
      <h1 class="mt-4 text-2xl font-light text-zinc-200">Not Found</h1>
      <p class="mt-3 text-sm text-zinc-500">
        The page you're looking for doesn't exist.
      </p>
      <div class="mt-8 flex justify-center gap-6 text-xs tracking-[0.2em] text-zinc-500">
        <a href={jaHome} class="transition-colors hover:text-amber-400">JP</a>
        <a href={enHome} class="transition-colors hover:text-amber-400">EN</a>
      </div>
    </main>
  </body>
</html>

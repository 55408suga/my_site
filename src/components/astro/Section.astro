---
interface Props {
  id: string;
  title: string;
  label?: string;
}

const { id, title, label } = Astro.props;
---

<section id={id} class="mx-auto w-full max-w-2xl scroll-mt-16 px-6 pt-16 pb-2">
  <header
    data-reveal
    class="reveal mb-6 flex items-baseline gap-3 border-b border-zinc-800 pb-2"
  >
    <h2 class="text-sm font-medium tracking-[0.25em] text-amber-400 uppercase">
      {title}
    </h2>
    {label && <span class="text-xs text-zinc-500">{label}</span>}
  </header>
  <slot />
</section>

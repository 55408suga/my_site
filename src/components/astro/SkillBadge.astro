---
import TechIcon from './TechIcon.astro';

interface Props {
  label: string;
}

const { label } = Astro.props;
---

<span
  class="group flex items-center gap-3 border border-zinc-800 bg-zinc-950/40 px-4 py-3.5 transition-colors hover:border-amber-400/60 hover:bg-zinc-900/60"
>
  <TechIcon
    name={label}
    class="h-7 w-7 shrink-0 text-zinc-300 transition-colors group-hover:text-amber-400"
  />
  <span
    class="text-sm font-medium tracking-wide text-zinc-200 transition-colors group-hover:text-amber-400"
    >{label}</span
  >
</span>
